{
    "name": "hamaka/silverstripe-pasted-base64-images",
    "description": "Converts images pasted or dropped into the HTML editor (TinyMCE paste_data_images, stored as base64 data URIs) into regular files in the asset admin with an [image] shortcode, on save and for existing content including version history.",
    "type": "silverstripe-vendormodule",
    "homepage": "https://github.com/hamaka/silverstripe-pasted-base64-images",
    "keywords": [
        "silverstripe",
        "tinymce",
        "paste",
        "base64",
        "data-uri",
        "images",
        "assets",
        "database-size",
        "versions",
        "hamaka"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Carel Evers",
            "email": "carel@hamaka.nl",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hamaka/silverstripe-pasted-base64-images/issues",
        "source": "https://github.com/hamaka/silverstripe-pasted-base64-images"
    },
    "require": {
        "silverstripe/framework": "^5.3",
        "silverstripe/assets": "^2.3",
        "silverstripe/versioned": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Hamaka\\Base64Images\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hamaka\\Base64Images\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
